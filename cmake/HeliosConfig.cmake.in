# HeliosConfig.cmake — CMake package config for Helios Engine
#
# Provides:
#   helios::<alias>           - per-module targets (helios_app is helios::app)
#   helios_link_modules(...)  - consumer helper

@PACKAGE_INIT@

list(APPEND CMAKE_MODULE_PATH
    "${CMAKE_CURRENT_LIST_DIR}"
    "${CMAKE_CURRENT_LIST_DIR}/helpers"
)

include("${CMAKE_CURRENT_LIST_DIR}/HeliosTargets.cmake")
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/HeliosAliases.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/HeliosAliases.cmake")
endif()
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/HeliosSdkChecks.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/HeliosSdkChecks.cmake")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/Sanitizers.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ModuleDeclarations.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ModuleFinalize.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ModuleLinking.cmake")
